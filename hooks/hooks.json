{
  "hooks": {
    "MessageDisplay": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/rewrite.sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}"
            ],
            "timeout": 100
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/rewrite-md.sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}"
            ],
            "timeout": 180
          }
        ]
      }
    ]
  }
}
